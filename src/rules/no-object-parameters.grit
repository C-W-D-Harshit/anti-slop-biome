language js

// Disallow `object` function parameters; inputs must use an owner-provided
// type and be parsed at their boundary.
pattern broad_object() {
	or {
		TsNonPrimitiveType(),
		TsParenthesizedType(ty = broad_object()),
		TsUnionType(types = some broad_object())
	}
}

JsFormalParameter(type_annotation = TsTypeAnnotation(ty = $ty)) where {
	or {
		$ty <: broad_object(),
		and {
			$ty <: TsReferenceType(name = $alias_name),
			$program <: contains TsTypeAliasDeclaration(binding_identifier = $alias_name, ty = broad_object())
		}
	},
	register_diagnostic(
		span = $ty,
		message = "This parameter uses the broad `object` type. Accept a named owner type; parse external input at its boundary before calling this function."
	)
}
